{
  "manifest_version": "1.0.0",
  "name": "clarityforge",
  "display_name": "ClarityForge",
  "version": "0.1.0",
  "description": "Simulator-first BCI paper-trading companion: mock cognitive state, Decision Quality friction, intent-native orders, local heuristic memory. Not implant software. Not a medical device. Not a brokerage. Not affiliated with Neuralink.",
  "safety_class": "computer_side",
  "runtime": "web",
  "category": "research_utility",
  "featured": true,
  "collection": "col-neura-suite",
  "suite_role": "app",
  "depends_on": [],
  "inputs": ["synthetic"],
  "outputs": ["ui_only", "file_export"],
  "hardware": ["synthetic", "generic_intent"],
  "adapter_maturity": "simulator_only",
  "permissions": ["none"],
  "dof": "low_dof",
  "latency_class": "interactive",
  "platforms": ["web", "macos", "windows", "linux"],
  "calibration": "optional",
  "entrypoint": "/demo",
  "demo_video_url": "/demo",
  "a11y_url": "/a11y",
  "screenshots": [
    "/screenshots/01-desk.svg",
    "/screenshots/02-quality.svg",
    "/screenshots/03-demo.svg",
    "/screenshots/04-settings.svg",
    "/screenshots/05-a11y.svg",
    "/og.svg"
  ],
  "repository": "https://github.com/pileofflapjacks1/clarityforge",
  "license": "MIT",
  "banned_claims": true
}
